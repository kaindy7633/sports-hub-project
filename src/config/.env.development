# 开发环境配置

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sports-hub

# JWT配置
JWT_SECRET=your_jwt_secret_key_dev
JWT_EXPIRATION_TIME=24h

# 应用配置
PORT=9000
API_PREFIX=/api
API_VERSION=v1

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=sports-hub:
REDIS_TTL=3600

# 文件上传配置
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880