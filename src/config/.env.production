# 生产环境配置

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password
DB_DATABASE=sports-hub_prod

# JWT配置
JWT_SECRET=your_strong_jwt_secret_key_prod
JWT_EXPIRATION_TIME=3600

# 应用配置
PORT=9000
API_PREFIX=/api
API_VERSION=v1

# Redis配置（如果需要）
REDIS_HOST=localhost
REDIS_PORT=6379

# 文件上传配置
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# 安全配置
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100